[TEMPLATE]
# Prefrontal — API Keys Configuration
# Copy this file to .env and fill in your keys.
# Provider keys stay in this server process and are never returned by /api/config.
# Leave a key blank to configure it manually in the Settings UI instead.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenAI direct (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Together AI (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Anthropic (reported as available, but not yet a UI runtime)
ANTHROPIC_API_KEY=

# Optional proxy hardening for custom OpenAI-compatible gateways.
# Known provider hosts are allowlisted automatically.
# PROXY_ALLOWED_HOSTS=llm.example.com
# Set true only when an explicitly allowlisted HTTP LAN gateway is required.
# PROXY_ALLOW_HTTP=false
# Maximum proxied requests per client IP per minute (default: 60).
# PROXY_RATE_LIMIT=60

# Server port (default: 3000)
# PORT=3000

# Localhost auto-connect for the Prefrontal Agent. On startup the server
# writes a random secret to ~/.prefrontal-agent/shared-secret (mode 0600)
# and the agent reads it to auto-pair in the background, replacing the
# manual pairing-token flow. Override/pin these only if you need to.
# PREFRONTAL_SHARED_SECRET=my-pinned-secret
# PREFRONTAL_SHARED_SECRET_FILE=/path/to/shared-secret
